server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json application/geo+json image/svg+xml;
    gzip_min_length 1k;

    # 安全响应头（style unsafe-inline：Leaflet 运行时内联样式必需）
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://webrd01.is.autonavi.com https://webrd02.is.autonavi.com https://webrd03.is.autonavi.com https://webrd04.is.autonavi.com data:; connect-src 'self'; font-src 'self' data:" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 高德 POI 检索代理（Key 由容器环境变量 AMAP_WEB_KEY 注入，不暴露给浏览器）
    location /api/amap/place {
        proxy_ssl_server_name on;
        resolver 114.114.114.114 8.8.8.8 valid=300s ipv6=off;
        proxy_pass https://restapi.amap.com/v3/place/text?key=${AMAP_WEB_KEY}&$args;
    }
    location /api/amap/tips {
        proxy_ssl_server_name on;
        resolver 114.114.114.114 8.8.8.8 valid=300s ipv6=off;
        proxy_pass https://restapi.amap.com/v3/assistant/inputtips?key=${AMAP_WEB_KEY}&$args;
    }

    location = /index.html {
        expires -1;
    }
    location ~* \.(css|js|geojson)$ {
        expires -1;
        etag on;
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 30d;
    }
    location ^~ /vendor/ {
        expires 30d;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
